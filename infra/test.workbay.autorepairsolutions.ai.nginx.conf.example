# Host-level Nginx configuration for the isolated Workbai test service.
# Install only after Cloudflare DNS resolves to this host and Certbot has issued this hostname's certificate.
# Dashboard owns /api/check-in and other same-origin BFF routes; do not proxy browser traffic directly to FastAPI.
server {
    listen 80;
    listen [::]:80;
    server_name test.workbay.autorepairsolutions.ai;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name test.workbay.autorepairsolutions.ai;

    ssl_certificate /etc/letsencrypt/live/test.workbay.autorepairsolutions.ai/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/test.workbay.autorepairsolutions.ai/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;

    location / {
        proxy_pass http://127.0.0.1:13000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 90s;
    }
}
