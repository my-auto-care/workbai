# Host-level Nginx configuration for the isolated Workbai test service.
# Install only after Cloudflare DNS resolves to this host and Certbot has issued this hostname's certificate.
# Dashboard owns /api/check-in and other same-origin BFF routes; do not proxy browser traffic directly to FastAPI.
# Before enabling Current Visit, define this once in the surrounding `http {}` block:
#   limit_req_zone $binary_remote_addr zone=workbai_current_visit_ip:10m rate=10r/m;
# If a CDN/load balancer precedes Nginx, configure real_ip_header and exact trusted
# upstream addresses first so $remote_addr is the verified client address. Do not enable
# WORKBAI_CURRENT_VISIT_EDGE_VERIFIED until CURRENT_VISIT_EDGE_GATE.md is fully proven.
server {
    listen 80;
    listen [::]:80;
    server_name test.workbay.autorepairsolutions.ai;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location ^~ /v/ { access_log off; return 404; }
    location ^~ /api/public-current-visit/ { access_log off; return 404; }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name test.workbay.autorepairsolutions.ai;

    ssl_certificate /etc/letsencrypt/live/test.workbay.autorepairsolutions.ai/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/test.workbay.autorepairsolutions.ai/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;

    # Only exact `/v` and resolver locations below may be public.
    location ^~ /v/ { access_log off; return 404; }
    location ^~ /api/public-current-visit/ { access_log off; return 404; }

    # Exact counter-only Current Visit page. The issued secret is in the URL fragment,
    # so this GET is only `/v`; disable logs nevertheless and overwrite edge headers.
    location = /v {
        access_log off;
        limit_req zone=workbai_current_visit_ip burst=5 nodelay;
        proxy_pass http://127.0.0.1:13000;
        proxy_set_header Host $host;
        proxy_set_header X-Workbai-Public-Edge-Verified "1";
        proxy_set_header X-Workbai-Public-Client-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
        proxy_set_header X-Workbai-Public-Resolver-Key "";
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "no-store, private, max-age=0" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
    }

    # The fragment secret is sent only in this JSON POST body. Access logging stays off;
    # the dashboard BFF rejects any request missing the edge-overwritten marker.
    location = /api/public-current-visit/resolve {
        access_log off;
        limit_req zone=workbai_current_visit_ip burst=5 nodelay;
        proxy_pass http://127.0.0.1:13000;
        proxy_set_header Host $host;
        proxy_set_header X-Workbai-Public-Edge-Verified "1";
        proxy_set_header X-Workbai-Public-Client-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
        proxy_set_header X-Workbai-Public-Resolver-Key "";
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "no-store, private, max-age=0" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
    }

    location / {
        proxy_pass http://127.0.0.1:13000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 90s;
    }
}
