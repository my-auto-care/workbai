# Anthropic
ANTHROPIC_API_KEY=

# AssemblyAI
ASSEMBLYAI_API_KEY=

# ElevenLabs
ELEVENLABS_API_KEY=

# LiveKit
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
# Name the voice worker registers under and /voice/token dispatches to.
# Defaults to workbai-inspection; must be the same for the API and the worker.
LIVEKIT_AGENT_NAME=

# Auth0 API validation (FastAPI). The dashboard uses its own app credentials in dashboard/.env.test.
AUTH0_DOMAIN=
AUTH0_API_AUDIENCE=
# Comma-separated full origins only; e.g. https://test.workbay.autorepairsolutions.ai
CORS_ALLOWED_ORIGINS=
# Secret used only by the internal stale-session scheduler; never send from browser code.
WORKBAI_SCHEDULER_SECRET=
# Service credential for the LiveKit voice worker (app/voice). The API and the
# voice-agent container both read it from this file. At least 32 characters;
# generate with: openssl rand -hex 32. Unset/short = the worker gets 401s.
# It only lets the worker read an active legacy inspection and its checklist,
# save findings, complete it, and request vehicle intelligence for it.
WORKBAI_VOICE_AGENT_TOKEN=
# Routers production already serves (mobile app, voice worker, Stripe). Every
# route in them requires staff Auth0, the voice-agent credential or a valid
# Stripe signature. Unset = ON (keeps today's production behaviour); set to
# false to unmount one (the isolated test stack sets all four to false).
WORKBAI_ENABLE_VOICE_INSPECTION=true
WORKBAI_ENABLE_VEHICLE_LOOKUP=true
WORKBAI_ENABLE_EXPERIMENTAL_VEHICLE_AI=true
WORKBAI_ENABLE_BILLING=true
# Technician self-started (non-template) inspections from the mobile app
# (POST /sessions). Unset = ON. Turn off once the app records Check-in visits.
WORKBAI_ENABLE_LEGACY_MOBILE_SESSIONS=true

# Internal customer context — required only to create/search encrypted customer
# profiles, contact methods, curated reason wording, and visit-bound transcript/
# appointment/service-history context. These settings do not enable Current Visit,
# public routes, telephony webhooks, customer messages, or AI processing.
WORKBAI_CUSTOMER_DATA_ENCRYPTION_KEY=
WORKBAI_CUSTOMER_DATA_ENCRYPTION_KEY_ID=
WORKBAI_CUSTOMER_SEARCH_HMAC_PEPPER=
WORKBAI_VEHICLE_CATALOG_SOURCE=nhtsa_vpic

# Current Visit release — default off. This feature permits only manager-approved,
# view-only counter links. It does not enable SMS/email delivery, customer decisions,
# estimates, inspection media, or AI explanations.
WORKBAI_ENABLE_CURRENT_VISIT_RELEASE=false
# Must stay false until the installed edge has a tested, token-safe /v/ route with
# redacted/disabled bearer-link logging and an overwriting client-address header.
WORKBAI_CURRENT_VISIT_EDGE_VERIFIED=false
WORKBAI_CONTACT_ENCRYPTION_KEY=
WORKBAI_CONTACT_ENCRYPTION_KEY_ID=
WORKBAI_CONTACT_LOOKUP_HMAC_PEPPER=
WORKBAI_PUBLIC_LINK_HMAC_PEPPER=
WORKBAI_PUBLIC_LINK_HMAC_KEY_ID=
WORKBAI_PUBLIC_ACCESS_AUDIT_PEPPER=
WORKBAI_PUBLIC_RESOLVER_SHARED_SECRET=
WORKBAI_PUBLIC_GLOVEBOX_ORIGIN=https://test.workbay.autorepairsolutions.ai
WORKBAI_PUBLIC_SUPPORT_PHONE=

# Stripe. The API reads STRIPE_SECRET_KEY (set it to the test or live key for
# that environment) and verifies every webhook with STRIPE_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=
STRIPE_SECRET_KEY_TEST=
STRIPE_SECRET_KEY_LIVE=
STRIPE_PUBLISHABLE_KEY_TEST=
STRIPE_PUBLISHABLE_KEY_LIVE=
STRIPE_WEBHOOK_SECRET=

# DigitalOcean
DO_API_TOKEN=
DO_SPACES_ACCESS_KEY=
DO_SPACES_SECRET_KEY=
DO_SPACES_ENDPOINT=
DO_SPACES_REGION=
DO_SPACES_BUCKET_DATA=
DO_SPACES_BUCKET_CHECKPOINTS=

# Database
DATABASE_URL=

# OpenAI
OPENAI_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# Infrastructure
ORCHESTRATOR_VPS_IP=
BACKEND_VPS_IP=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
