# Workbai dashboard — test/staff runtime configuration
# Values are supplied by the runtime secret store, never committed.
APP_BASE_URL=https://test.workbay.autorepairsolutions.ai
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
# Auth0 API identifier whose RS256 access tokens the FastAPI backend validates.
AUTH0_API_AUDIENCE=
# Docker-internal only. Do not expose as NEXT_PUBLIC_*.
WORKBAI_BACKEND_INTERNAL_URL=http://backend:8000
# Default-off Current Visit release. This permits only manager-approved, view-only
# counter links; it does not enable SMS/email delivery or customer action endpoints.
WORKBAI_ENABLE_CURRENT_VISIT_RELEASE=false
# Dashboard server only; must match the backend and never use NEXT_PUBLIC_.
WORKBAI_PUBLIC_RESOLVER_SHARED_SECRET=
