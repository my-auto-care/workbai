# Workbai dashboard — test/staff runtime configuration
# Values are supplied by the runtime secret store, never committed.
APP_BASE_URL=https://test.workbay.autorepairsolutions.ai
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
# Auth0 API identifier whose RS256 access tokens the FastAPI backend validates.
AUTH0_API_AUDIENCE=
# Docker-internal only. Do not expose as NEXT_PUBLIC_*.
WORKBAI_BACKEND_INTERNAL_URL=http://backend:8000
